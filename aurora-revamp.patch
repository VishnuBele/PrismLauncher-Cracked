+#include <QString>
+
+/*!
+ * Matching rule for the home screen search box.
+ *
+ * Case-insensitive substring match on the instance name; surrounding
+ * whitespace is ignored, and an empty filter matches everything. Kept free of
+ * launcher dependencies so it can be unit tested on its own, and used by
+ * InstanceProxyModel::filterAcceptsRow().
+ */
+inline bool instanceNameMatchesFilter(const QString& name, const QString& filter)
+{
+    const QString needle = filter.trimmed();
+    if (needle.isEmpty())
+        return true;
+
+    return name.contains(needle, Qt::CaseInsensitive);
+}
